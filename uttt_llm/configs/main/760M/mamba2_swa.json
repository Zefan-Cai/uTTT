{
  "architectures": [
    "Mamba2WindowMixForCausalLM"
  ],
  "model_type": "mamba2_swa",
  "bos_token_id": 1,
  "eos_token_id": 2,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "fuse_norm": true,
  "initializer_range": 0.02,
  "max_position_embeddings": 32768,
  "tie_word_embeddings": false,
  "use_cache": false,
  "use_l2warp": false,
  "vocab_size": 32000,
  "hidden_size": 1536,
  "num_hidden_layers": 24,
  "norm_eps": 1e-06,
  "state_size": 1152,
  "head_dim": 64,
  "expand": 1,
  "conv_kernel": 4,
  "n_groups": 1,
  "use_bias": false,
  "use_conv_bias": true,
  "hidden_act": "silu",
  "residual_in_fp32": false,
  "rms_norm": true,
  "norm_before_gate": false,
  "chunk_size": 256,
  "attn_head_dim": 64,
  "window_size": 4096,
  "rope_theta": 1000000.0,
  "attn_num_heads": 24,
  "hidden_ratio": 3.5,
  "intermediate_size": 2304,
  "fuse_swiglu": true,
  "rescale_prenorm_residual": false
}
